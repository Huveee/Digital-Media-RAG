# ===========================================
# P2 Backend Server - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# ChatAI API Configuration (Required)

CHATAI_API_KEY=your_api_key_here 
BASE_URL=https://chat-ai.academiccloud.de/v1

# Available Models (comma-separated)
CHATAI_MODELS=deepseek-r1,meta-llama-3.1-8b-instruct,meta-llama-3.1-8b-rag,llama-3.1-sauerkrautlm-70b-instruct,llama-3.3-70b-instruct,gemma-3-27b-it,mistral-large-instruct,qwen3-235b-a22b,qwen3-32b,openai-gpt-oss-120b
DEFAULT_CHATAI_MODEL=meta-llama-3.1-8b-rag


# Application Configuration
VARLLM_STYLES=Chatbots/varllm_styles.json

# Frontend Authentication (Required)
# Generate a strong random key for production (e.g., openssl rand -hex 32)
FRONTEND_SECRET_KEY=generate_a_strong_random_key_here
FRONTEND_ALLOWED_ORIGINS=http://localhost:3000,https://comai-chat.apps.informatik.uni-bremen.de


# Database Configuration
# For Dokku: Set DATABASE_PATH to mounted storage location

# DATABASE_PATH=/app/storage/chat_history_database_v2.db // IMPORTANT: Do not set this variable when running locally, it will default to a local file in the project directory but for production, set it to a persistent storage path
